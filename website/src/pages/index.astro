---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "DANMU — 哔哩哔哩终端弹幕工作台";
const description = "专为哔哩哔哩（B站）直播间设计的终端弹幕与互动工作台，目前不接入其他直播平台。支持 macOS、Linux 与 Windows。";

const installers = [
  { id: "npm", label: "NPM", command: "npm install -g danmu-tui" },
  { id: "brew", label: "BREW", command: "brew install rockythink/tap/danmu" },
  { id: "curl", label: "CURL", command: "curl -fsSL https://raw.githubusercontent.com/rockythink/shisui-danmu/main/script/install_release.sh | bash" },
  { id: "cargo", label: "CARGO", command: "cargo install shisui-danmu --locked" },
];

const platforms = [
  { code: "MAC", name: "macOS", architectures: "ARM64 · X64" },
  { code: "LNX", name: "Linux", architectures: "ARM64 · X64" },
  { code: "WIN", name: "Windows", architectures: "X64" },
];

const featureRows = [
  {
    number: "01",
    title: "不漏掉对话的来路",
    description: "历史弹幕与实时消息合并、去重；连接抖动时自动重连。观众正在说什么，不因一次断线消失。",
  },
  {
    number: "02",
    title: "把重要问题钉在眼前",
    description: "键盘选中一条弹幕，插入 @用户名，或直接设为重点。问题不会在滚动的信息流里沉底。",
  },
  {
    number: "03",
    title: "发出去，也知道发成功了",
    description: "长弹幕按 Unicode 字素安全分段，并等待主播身份回流确认。不是按下 Enter 后只能猜。",
  },
  {
    number: "04",
    title: "现场状态，抬眼就能确认",
    description: "开播时长、看过、点赞、弹幕、在线人数，以及 OBS 与单路麦克风状态集中在同一视野。",
  },
  {
    number: "05",
    title: "直播结束，上下文不会清零",
    description: "每场互动持续写入独立 Journal；支持恢复未结束会话、搜索归档并导出现场快照。",
  },
];

---

<BaseLayout title={title} description={description}>
  <div class="app-shell">
    <div class="crt-grid" aria-hidden="true"></div>
    <div class="scanline" aria-hidden="true"></div>

    <header class="topbar">
      <a class="logo" href="/" aria-label="DANMU 首页">
        <img src="/logo-pixel.svg" alt="" width="32" height="32" />
        <span>DANMU</span>
      </a>
      <nav aria-label="主要导航">
        <a href="https://github.com/rockythink/shisui-danmu#快速开始" target="_blank" rel="noreferrer">DOCS</a>
        <a href="https://github.com/rockythink/shisui-danmu/releases/latest" target="_blank" rel="noreferrer">RELEASES</a>
        <a href="#features">FEATURES</a>
        <a class="icon-link" href="https://github.com/rockythink/shisui-danmu" target="_blank" rel="noreferrer" aria-label="GitHub">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.4c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.78 1.2 1.78 1.2 1.04 1.77 2.72 1.26 3.38.96.1-.75.4-1.26.74-1.55-2.57-.29-5.27-1.28-5.27-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.71 5.38-5.29 5.67.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" /></svg>
        </a>
      </nav>
    </header>

    <main id="main-content" class="main-frame">
      <section class="hero-head" aria-labelledby="hero-title">
        <div class="hero-brand">
          <img class="hero-logo" src="/logo-pixel.svg" alt="DANMU 像素对话终端标志" width="78" height="78" />
          <div class="hero-copy">
            <div class="wordmark"><b>DANMU</b><span>哔哩哔哩终端弹幕工作台</span></div>
            <h1 id="hero-title">不用直播姬，<span>终端也能接住弹幕。</span></h1>
            <p class="hero-proof">专为哔哩哔哩（B站）直播间设计，目前不接入其他直播平台。让 macOS、Linux，以及直播姬不适用场景里的主播，直接在终端接住弹幕与互动。</p>
          </div>
        </div>

        <div class="platform-block" aria-label="支持的平台">
          <div class="platform-heading"><span>全平台原生支持</span><b>5 个构建版本</b></div>
          <div class="platform-list">
            {platforms.map((platform) => (
              <div class="platform-item">
                <strong>{platform.code}</strong>
                <span><b>{platform.name}</b><small>{platform.architectures}</small></span>
                <i aria-hidden="true"></i>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="hero-actions" aria-label="安装与源码">
        <div class="action-intro"><span>立即安装</span><strong>选一种方式，复制命令。</strong></div>
        <div class="install-console">
          <div class="install-tabs" role="tablist" aria-label="安装方式">
            {installers.map((item, index) => (
              <button type="button" role="tab" id={`tab-${item.id}`} aria-controls={`panel-${item.id}`} aria-selected={index === 0 ? "true" : "false"} tabindex={index === 0 ? 0 : -1} class:list={{ active: index === 0 }} data-install-tab={item.id}>{item.label}</button>
            ))}
          </div>
          <div class="install-panels">
            {installers.map((item, index) => (
              <div class="install-command" role="tabpanel" id={`panel-${item.id}`} aria-labelledby={`tab-${item.id}`} hidden={index !== 0} data-install-panel={item.id}>
                <div><b aria-hidden="true">$</b><code>{item.command}</code></div>
                <button type="button" data-copy={item.command} aria-label={`复制 ${item.label} 安装命令`}>复制命令</button>
              </div>
            ))}
          </div>
        </div>
        <a class="github-cta" href="https://github.com/rockythink/shisui-danmu" target="_blank" rel="noreferrer"><span>查看源码</span><strong>GitHub ↗</strong></a>
        <div class="copy-status" data-copy-status aria-live="polite"></div>
      </section>

      <div class="product-grid">
      <section class="product-stage" aria-label="DANMU 实机运行录屏">
        <div class="stage-heading">
          <div><span></span><b>真实产品录屏</b></div>
          <div><b>56 秒</b><span>·</span><span>完整会话</span></div>
        </div>

        <div class="video-frame">
          <video
            class="product-video"
            controls
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster="/tui-preview.png"
            aria-label="DANMU 在真实终端中的 56 秒运行录屏"
          >
            <source src="/danmu-product-demo.mp4" type="video/mp4" />
            你的浏览器不支持 HTML5 视频。<a href="/danmu-product-demo.mp4">下载实机录屏</a>。
          </video>
        </div>

        <div class="stage-caption">
          <span>B站直播间完整实机录屏 · 无模拟画面</span>
          <a href="/danmu-product-demo.mp4" download>下载视频 ↓</a>
        </div>
      </section>

        <section class="install-dock" aria-label="安装 DANMU">
          <div class="install-intro">
            <span>开始使用</span>
            <b>装好以后，<br />只需要一个 B站房间号。</b>
          </div>
          <div class="install-guide" aria-label="快速开始">
            <div><span>01</span><p><b>进入 B站直播间</b><code>danmu &lt;房间号&gt;</code></p></div>
            <div><span>02</span><p><b>登录（可选）</b><code>danmu --login</code></p></div>
            <div><span>03</span><p><b>打开命令面板</b><code>按下 /</code></p></div>
          </div>
          <div class="install-platforms">
            <span><i></i>macOS</span><span><i></i>Linux</span><span><i></i>Windows</span>
            <small>原生二进制 · 无需云端账号</small>
          </div>
        </section>
      </div>

      <section class="feature-section" id="features" aria-labelledby="features-title">
        <header class="feature-header">
          <div class="section-kicker"><span></span>功能亮点</div>
          <h2 id="features-title">不是多一块屏幕。<br />是少错过一个人。</h2>
          <p>把 B站直播间里和“人”有关的信号留在同一条时间线上，让主播看见谁来了、谁在问、谁在支持，以及上一句话从哪里开始。</p>
        </header>

        <div class="relationship-band">
          <div>
            <span>用户互动信号</span>
            <strong>互动先有名字，数据才有意义。</strong>
          </div>
          <div class="event-rail" aria-label="DANMU 支持的互动事件">
            <span>弹幕</span><span>进场</span><span>关注</span><span>分享</span><span>点赞</span><span>礼物</span><span>舰长</span><span>SC</span>
          </div>
        </div>

        <div class="feature-ledger">
          {featureRows.map((feature) => (
            <article class="feature-row">
              <span class="feature-number">{feature.number}</span>
              <div class="feature-name"><h3>{feature.title}</h3></div>
              <p>{feature.description}</p>
            </article>
          ))}
        </div>
      </section>

    </main>

    <footer class="site-footer">
      <div class="footer-author">
        <span>DANMU 作者</span>
        <div>
          <strong>石头 · Elazer Wang</strong>
          <p>11 年数据工作经验，现专注 AI、数据系统与独立开发。</p>
        </div>
        <a class="author-site" href="https://elazer.wang" target="_blank" rel="noreferrer">访问个人网站 ↗</a>
      </div>
      <div class="footer-meta">
        <a href="https://github.com/rockythink/shisui-danmu" target="_blank" rel="noreferrer"><span>◆</span> MPL-2.0 · OPEN SOURCE</a>
        <a class="footer-recording" href="/danmu-product-demo.mp4" target="_blank" rel="noreferrer">观看实机录屏</a>
        <span class="footer-platforms">MACOS · LINUX · WINDOWS</span>
      </div>
    </footer>
  </div>

  <script>
    const installerTabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-install-tab]"));
    const installerPanels = Array.from(document.querySelectorAll<HTMLElement>("[data-install-panel]"));

    const selectInstaller = (tab: HTMLButtonElement) => {
      const target = tab.dataset.installTab;
      installerTabs.forEach((item) => {
        const active = item === tab;
        item.classList.toggle("active", active);
        item.setAttribute("aria-selected", String(active));
        item.tabIndex = active ? 0 : -1;
      });
      installerPanels.forEach((panel) => { panel.hidden = panel.dataset.installPanel !== target; });
    };

    installerTabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectInstaller(tab));
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        const direction = event.key === "ArrowRight" ? 1 : -1;
        const next = installerTabs[(index + direction + installerTabs.length) % installerTabs.length];
        selectInstaller(next);
        next.focus();
      });
    });

    const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]");
    document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", async () => {
        const command = button.dataset.copy ?? "";
        try {
          await navigator.clipboard.writeText(command);
        } catch {
          const field = document.createElement("textarea");
          field.value = command;
          field.style.position = "fixed";
          field.style.opacity = "0";
          document.body.append(field);
          field.select();
          const legacyDocument = document as unknown as { execCommand: (command: string) => boolean };
          legacyDocument.execCommand("copy");
          field.remove();
        }
        button.textContent = "已复制";
        if (copyStatus) copyStatus.textContent = "命令已复制";
        window.setTimeout(() => { button.textContent = "复制命令"; if (copyStatus) copyStatus.textContent = ""; }, 1400);
      });
    });
  </script>
</BaseLayout>
